{
  "samasya-001": {
    "samasya": "గాచె విష్ణుమూర్తి నీచ జనుల",
    "lines": [
      "యుగ యుగమ్ము లాది నుర్వియందలి నీతి",
      "గాచె విష్ణుమూర్తి ; నీచ జనుల",
      "నడచి వేయుచుండి యవతారముల దాల్చి",
      "శిష్ట జనుల రక్ష చేయు చెపుడు!"
    ],
    "audio": "samasya-001.mp3",
    "chandassu": "ఆటవెలది",
    "poet": "శనగవరపు వేంకట కృష్ణమూర్తి - Sanagavarapu Venkata Krishnamurthy"
  },
  "samasya-002": {
    "samasya": "సున్న మార్కులు ర్యాంకేమొ జూడ ఫస్టు!",
    "lines": [
      "ఎన్నడును పాఠశాలకు నేగ డతడు",
      "రిత్త పత్రంబు నిడగ పరీక్ష లందు",
      "సున్న మార్కులు! ర్యాంకేమొ జూడ ఫస్టు!",
      "\"యెన్టియే\" వారి లీలల వెంత ఘనము !"
    ],
    "audio": "samasya-002.mp3",
    "chandassu": "తేటగీతి",
    "poet": "శనగవరపు వేంకట కృష్ణమూర్తి - Sanagavarapu Venkata Krishnamurthy"
  },
  "samasya-003": {
    "samasya": "నాలుగు లఘువులు గురువగు నయముగ సుకవీ",
    "lines": [
      "తేలిక గడ్డి పరక గన!",
      "లీలగ త్రుంచ నగు గాదె లేశపు బలమున్?",
      "పేలవ మైనను, నవియే",
      "నాలుగు\"లఘువులు\"\"గురువగు\" నయముగ సుకవీ!"
    ],
    "audio": "samasya-003.mp3",
    "chandassu": "కందం",
    "meaning": "లేశపు = అతి తక్కువ ; లఘువులు = అల్పమైనవి ; \n గురువగు = దృఢమగు",
    "poet": "శనగవరపు వేంకట కృష్ణమూర్తి - Sanagavarapu Venkata Krishnamurthy"
  },
  "samasya-004": {
    "samasya": "వహ్ని పుట్టెను హిమవన్నగమున",
    "lines": [
      "మంచు కొండ లందు మించు తేజముతోడ",
